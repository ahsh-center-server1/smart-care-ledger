rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 이 앱은 Firebase Auth를 사용하지 않습니다.
    // (Firestore users 컬렉션에서 ID/PW 직접 비교 방식)
    // request.auth가 항상 null이므로 시간 기반 규칙 사용.
    // 세밀한 권한 제어는 app.js의 can() 함수로 처리됩니다.
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2030, 12, 31);
    }
  }
}