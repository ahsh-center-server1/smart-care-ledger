rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Smart Care Ledger — Firestore 보안 규칙
//
// 인증: Cloud Functions(login)가 비밀번호를 검증하고 커스텀 토큰을 발급한다.
//       토큰 클레임 { role, isAdmin }, uid == users 문서 ID == 로그인 아이디.
//
// ⚠️ 배포 순서 (BUGFIX_PLAN.md 「설계 6」)
//    이 파일은 **배포 3**에서 적용한다. 마이그레이션(배포 1)과 앱 전환(배포 2)이
//    끝나기 전에 적용하면 전원 로그인 불가가 된다.
//
// 참고: Firestore 규칙에서 allow는 가산적이다. 어떤 규칙도 허용하지 않으면
//       기본 거부되므로 별도의 catch-all deny 블록은 두지 않는다.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // 역할 서열. 토큰에 role이 없으면 0 → 권한 없음(fail-closed).
    function rank() {
      return {'입력자': 1, '담당자': 2, '팀장': 3, '센터장': 4}
        .get(request.auth.token.get('role', ''), 0);
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('isAdmin', false) == true;
    }

    // 등급 n 이상인가 (관리자는 항상 통과)
    function atLeast(n) {
      return signedIn() && (isAdmin() || rank() >= n);
    }

    function myUid() { return request.auth.uid; }

    // ── 비밀번호 해시 — 클라이언트 접근 전면 차단 (Functions는 Admin SDK로 우회) ──
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // ── 직원 ──
    // 비밀번호가 userSecrets로 분리되었으므로 남는 값은 이름·역할·팀뿐인 내부 인명부다.
    // 로그인한 직원은 조회 가능(앱이 users 컬렉션 전체를 로드해 팀장/결재자 이름을 찾는다).
    // 쓰기는 Cloud Functions 전용 — 역할 변경·승인·비밀번호를 클라이언트가 못 건드린다.
    match /users/{uid} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── 입주자 · 계좌 ── 조회는 로그인 전원, 변경은 팀장 이상
    match /clients/{id}  { allow read: if signedIn(); allow write: if atLeast(3); }
    match /accounts/{id} { allow read: if signedIn(); allow write: if atLeast(3); }

    // ── 거래 ──
    // 입력자(등급 1)는 본인이 작성한 거래만.
    // ⚠️ 목록 조회 시 클라이언트가 where('createdBy','==',uid)를 함께 걸어야 한다.
    //    규칙 엔진이 결과 전체의 조건 충족을 증명할 수 없으면 쿼리가 통째로 거부된다.
    match /transactions/{id} {
      allow read: if atLeast(2)
                  || (signedIn() && resource.data.get('createdBy', '') == myUid());

      allow create: if signedIn()
                    && request.resource.data.get('createdBy', '') == myUid();

      allow update, delete: if atLeast(2)
                            || (signedIn() && resource.data.get('createdBy', '') == myUid());
    }

    // ── 카테고리 · 고정항목 ── 담당자 이상이 편집
    match /categories/{id} { allow read: if signedIn(); allow write: if atLeast(2); }
    match /fixedItems/{id} { allow read: if signedIn(); allow write: if atLeast(2); }

    // ── 보고서 ── 입력자는 접근 불가
    match /reports/{id} { allow read, write: if atLeast(2); }

    // ── 예산 ── 조회는 담당자 이상, 변경은 팀장 이상
    match /budgets/{id} { allow read: if atLeast(2); allow write: if atLeast(3); }

    // ── 엑셀 업로드 이력 ──
    match /excelUploads/{id} { allow read, write: if atLeast(2); }

    // ── 변경 이력 (감사 로그) ──
    //
    // 이 앱은 브라우저가 Firestore에 직접 쓰기 때문에 "로그를 반드시 남기게"
    // 강제할 수는 없다(모든 쓰기를 Functions로 옮겨야 가능하다). 대신
    // **남은 기록은 손댈 수 없게** 만든다:
    //
    //   · update·delete 금지 → 한 번 쓰인 기록은 수정·삭제 불가 (추가 전용)
    //   · actorUid == 토큰 uid → 남의 이름으로 기록을 만들 수 없다
    //   · timestamp == request.time → 시각을 소급하거나 미래로 밀 수 없다
    //     (serverTimestamp()가 정확히 이 값이 된다)
    //   · expireAt 필수 → TTL 정책이 2년 후 자동 삭제한다. 이 필드가 없는
    //     기록은 영구히 남아 저장 비용이 계속 늘어난다.
    //
    // 조회는 등급 3(팀장) 이상 — 다른 직원의 활동 기록이므로 담당자에게는 열지 않는다.
    match /auditLogs/{id} {
      allow read: if atLeast(3);
      allow create: if signedIn()
                    && request.resource.data.actorUid == myUid()
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.expireAt is timestamp;
      allow update, delete: if false;
    }

    // ── 파생 명부 (directories/staff · directories/categories) ──
    //
    // 로그인 한 번에 users·categories 컬렉션을 통째로 읽지 않기 위한 문서다
    // (functions/directories.cjs 참고). 조회는 로그인 전원 — 앱이 뜨려면
    // 직원 이름과 분류 목록이 필요하고, 그것은 모든 역할에 해당한다.
    //
    // 쓰기는 **전면 차단**한다. 요약 캐시와 달리 클라이언트가 이것을 계산할
    // 이유가 전혀 없다(서버가 원본을 그대로 옮겨 담을 뿐이다). Cloud Functions는
    // Admin SDK라 규칙을 우회하므로 트리거는 그대로 동작한다.
    //
    // 이 차단이 중요한 이유: 명부에는 직원의 역할이 들어 있다. 클라이언트가
    // 쓸 수 있으면 자기 역할을 '센터장'으로 적어 화면 권한을 넓힐 수 있다
    // (실제 권한은 토큰 클레임이 정하므로 데이터는 못 건드리지만, 화면에
    //  결재 버튼이 뜨는 것만으로도 혼란과 오탐 신고가 생긴다).
    match /directories/{id} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── 월별 요약 캐시 ──
    //
    // 대시보드가 당월 거래 전체를 읽지 않게 하는 파생 문서다
    // (public/domain/monthly-summary.js 참고). 금액 합계가 들어 있지만
    // 원본 거래에서 계산된 값이므로 조회는 로그인 전원에게 연다 —
    // 입력자도 자기 담당 입주자의 카드를 봐야 한다.
    //
    // 쓰기가 미묘하다. 계산은 **브라우저가** 한다(서버가 하면 입력자에게
    // 보여도 되는 범위를 서버가 다시 판단해야 한다). 그래서 신뢰의 근거를
    // 규칙으로 좁힌다:
    //
    //   · 전 거래를 볼 수 있는 등급(2 이상)만 쓴다. 입력자는 본인 거래만
    //     읽으므로 그 계산 결과는 부분 합계다 — 코드도 그 경우 캐시에 쓰지
    //     않지만, 규칙에서도 막아 둔다.
    //   · sourceVersion은 **서버 트리거만** 올린다. 클라이언트는 갱신 시
    //     그 값을 바꿀 수 없다. 이 필드가 낡음 판정의 유일한 근거이므로,
    //     클라이언트가 내릴 수 있으면 낡은 캐시를 영구히 신선한 것으로
    //     위장할 수 있다.
    //   · 처음 만들 때만 sourceVersion 0을 심을 수 있다(그 뒤 거래가 한 번만
    //     바뀌어도 트리거가 1 이상으로 올려 무효화된다).
    //   · 삭제는 관리자만 — 캐시를 지우는 것은 정확성을 해치지 않지만
    //     (다시 계산된다) 읽기량이 튀므로 아무나 하지 않게 한다.
    match /summaryCaches/{id} {
      allow read: if signedIn();

      allow create: if atLeast(2)
                    && request.resource.data.clientId is string
                    && request.resource.data.schemaVersion is int
                    && request.resource.data.computedVersion is int
                    && request.resource.data.get('sourceVersion', -1) == 0
                    && request.resource.data.computedVersion == 0;

      allow update: if atLeast(2)
                    && request.resource.data.clientId is string
                    && request.resource.data.schemaVersion is int
                    && request.resource.data.computedVersion is int
                    && request.resource.data.get('sourceVersion', 0)
                       == resource.data.get('sourceVersion', 0)
                    // 아직 오지 않은 버전을 계산했다고 주장할 수 없다.
                    // (같으면 신선, 작으면 낡음 — 둘 다 정상이다)
                    && request.resource.data.computedVersion
                       <= resource.data.get('sourceVersion', 0);

      allow delete: if isAdmin();
    }

    // ── 오래 걸리는 파괴적 작업의 진행 상태 ──
    // 전체 초기화는 관리자만 실행하므로 상태도 관리자만 다룬다.
    // 다른 사람이 실행 중인지 확인하고 중단된 작업을 이어서 진행하기 위한 문서다.
    match /systemOperations/{id} {
      allow read, write: if isAdmin();
    }

    // ── 설정 ──
    // 권한 매트릭스 같은 설정은 관리자만.
    // 다만 연도 마감 이력(config/archive_YYYY)은 마감을 실행하는 센터장이 남겨야 한다.
    // 이 예외가 없으면 센터장이 마감을 시작하는 순간 이력 쓰기에서 거부된다.
    match /config/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin() || (id.matches('archive_[0-9]{4}') && atLeast(4));
    }

    // ── 연도 마감 아카이브 (archive_2025 등) ──
    // Firestore 규칙은 세그먼트 일부 와일드카드(archive_{year})를 지원하지 않으므로
    // 컬렉션명을 변수로 받아 정규식으로 판별한다.
    match /{col}/{id} {
      allow read:  if col.matches('archive_[0-9]{4}') && atLeast(2);
      allow write: if col.matches('archive_[0-9]{4}') && atLeast(4);
    }
  }
}
